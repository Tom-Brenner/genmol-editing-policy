# Large / mutable experiment artifacts (checksums and metadata stay in Git)
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep

# Keep small fixtures; ignore downloaded ChEMBL molecule dumps if large
data/fixtures/*.json
!data/fixtures/CHEMBL521.tsv
!data/fixtures/dry_run_parents.tsv
!data/fixtures/.gitkeep

# Frozen split is committed so the VM can git pull it (not rsync).
!manifests/*.jsonl
!manifests/hashes.json
!manifests/seeds.json
!manifests/.gitkeep

artifacts/**
!artifacts/.gitkeep
!artifacts/README.md
!artifacts/provenance.template.json
!artifacts/manifest_summary.json

results/**
!results/.gitkeep
!results/labels/.gitkeep
!results/test/.gitkeep
!results/confirmation/.gitkeep

# Python / tooling
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Vendor: keep GenMol source; exclude checkpoints and nested git metadata
vendor/genmol/.git/
vendor/genmol/checkpoints/**
!vendor/genmol/checkpoints/.gitkeep
*.ckpt

# Local probe leftovers
artifacts/_*.txt
artifacts/dry_run_report.json
artifacts/one_molecule_local_test.json
artifacts/throughput_report*.json
artifacts/genmol-v1.sha256
artifacts/genmol-v1.sha256.json

# V2 experiment outputs are large and reproducible from the public code/data.
# Small, explicitly force-added model and summary files are the only exceptions.
artifacts_v2/**
manifests_v2/**
results_v2/**

# Historical/private working notes and paper-preparation material.
GCP_SETUP.md
HF_instructions.md
RUNBOOK.md
abstract.md
additional_analysis_details.md
additional_refs.md
analysis.md
experiment-v2-handoff.md
feature_analysis.md
gat-handoff.md
implementation.md
paper-skeleton.md
plan.md
manuscript.pdf
docs/

# Superseded experiment namespaces remain local only.
artifacts/
manifests/
results/
